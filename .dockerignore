# Keep the build context small and the image clean of anything the running service does not
# need. The Dockerfile copies only contracts and backend by name, but excluding the rest here
# means Docker does not even send them, which makes every build faster.

.git
.gradle
**/build
*/build

# The desktop terminal and the empty dashboard are not part of the service.
terminal
dashboard
architecture

# Never bake a real database, or any secret, into an image.
**/data
**/*.db
**/*.db-*
.env
*.env

# Local tooling and notes.
tools
scratchpad
*.md
